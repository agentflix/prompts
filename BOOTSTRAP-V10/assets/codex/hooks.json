{
  "description": "PREVEC V10: os mesmos hooks do Claude Code, lidos de .claude/hooks.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.claude/hooks/guard.sh\"",
            "timeout": 10,
            "statusMessage": "Conferindo arquivos protegidos"
          },
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.claude/hooks/prevec.sh\" pre",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "<nome da tool de shell na doc atual do Codex, ex.: shell>",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.claude/hooks/fila.sh\"",
            "timeout": 10,
            "statusMessage": "Conferindo fila de testes"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.claude/hooks/format.sh\"",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.claude/hooks/prevec.sh\" plano",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.claude/hooks/gate.sh\"",
            "timeout": 600,
            "statusMessage": "Rodando gate rápido"
          }
        ]
      }
    ]
  }
}
