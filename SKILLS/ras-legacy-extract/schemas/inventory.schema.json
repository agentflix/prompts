{
  "title": "00-inventory/inventory.json",
  "type": "object",
  "required": ["contract_version", "generated_at", "generator", "items", "control_counts"],
  "properties": {
    "contract_version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "generated_at": {"type": "string"},
    "generator": {"type": "string", "minLength": 1},
    "items": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["key", "kind", "module", "source"],
        "properties": {
          "key": {"type": "string", "minLength": 1},
          "kind": {"type": "string", "enum": [
            "http_endpoint", "webhook", "cli_command", "scheduled_job", "queue_consumer", "screen",
            "db_table", "db_view", "db_procedure", "db_trigger", "db_sequence", "db_constraint",
            "inline_sql", "business_constant",
            "integration", "outbound_email", "file_io", "queue_producer",
            "config_key", "feature_flag", "auth_mechanism", "log_audit", "other"
          ]},
          "module": {"type": "string", "minLength": 1},
          "source": {"$ref": "#source"},
          "meta": {"type": "object"}
        }
      }
    },
    "control_counts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "command", "count"],
        "properties": {
          "kind": {"type": "string"},
          "command": {"type": "string", "minLength": 1},
          "count": {"type": "integer", "minimum": 0},
          "explanation": {"type": "string"}
        }
      }
    }
  }
}
