{
  "title": "02-modules/<mod>/module.json",
  "type": "object",
  "required": ["contract_version", "module", "apis", "requirements", "flows", "screens", "data", "exclusions"],
  "properties": {
    "contract_version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "module": {
      "type": "object", "required": ["code", "name"],
      "properties": {"code": {"type": "string", "pattern": "^[A-Z0-9]{2,6}$"}, "name": {"type": "string"}}
    },
    "apis": {"type": "array", "items": {
      "type": "object",
      "required": ["id", "inventory_key", "method", "path", "auth", "summary", "params", "responses", "sources", "requirements", "confidence", "critic"],
      "properties": {
        "id": {"type": "string", "pattern": "^API-[A-Z0-9]{2,6}-\\d{3}$"},
        "inventory_key": {"type": "string"},
        "method": {"type": "string"},
        "path": {"type": "string"},
        "auth": {"type": "string", "minLength": 1},
        "summary": {"type": "string", "minLength": 1},
        "params": {"type": "array", "items": {
          "type": "object", "required": ["name", "in", "type", "required"],
          "properties": {
            "name": {"type": "string", "minLength": 1},
            "in": {"type": "string", "enum": ["path", "query", "body", "form", "header", "cookie", "session"]},
            "type": {"type": "string", "minLength": 1},
            "required": {"type": ["boolean", "string"]},
            "validation": {"type": "string"},
            "description": {"type": "string"}
          }
        }},
        "responses": {"type": "array", "minItems": 1, "items": {
          "type": "object", "required": ["status", "when"],
          "properties": {
            "status": {"type": ["integer", "string"]},
            "when": {"type": "string", "minLength": 3},
            "body": {"type": "string"},
            "message": {"type": "string"},
            "requirements": {"type": "array", "items": {"type": "string"}}
          }
        }},
        "sources": {"$ref": "#sources"},
        "requirements": {"type": "array", "items": {"type": "string"}},
        "side_effects": {"type": "array", "items": {"type": "string"}},
        "no_screen_reason": {"type": "string"},
        "confidence": {"$ref": "#confidence"},
        "critic": {"$ref": "#critic"}
      }
    }},
    "requirements": {"type": "array", "items": {
      "type": "object",
      "required": ["id", "ears_type", "statement", "sources", "confidence", "critic"],
      "properties": {
        "id": {"type": "string", "pattern": "^REQ-[A-Z0-9]{2,6}-[UEWSO]\\d{3}$"},
        "ears_type": {"type": "string", "enum": ["ubiquitous", "event", "unwanted", "state", "optional"]},
        "statement": {"type": "string", "minLength": 10},
        "sources": {"$ref": "#sources"},
        "values": {"type": "object"},
        "confidence": {"$ref": "#confidence"},
        "critic": {"$ref": "#critic"},
        "findings": {"type": "array", "items": {"type": "string"}},
        "tags": {"type": "array", "items": {"type": "string"}},
        "lint_waivers": {"type": "array", "items": {
          "type": "object", "required": ["term", "reason"],
          "properties": {"term": {"type": "string", "minLength": 1}, "reason": {"type": "string", "minLength": 10}}
        }},
        "inventory_keys": {"type": "array", "items": {"type": "string"}}
      }
    }},
    "flows": {"type": "array", "items": {
      "type": "object", "required": ["id", "title", "apis", "requirements"],
      "properties": {
        "id": {"type": "string", "pattern": "^FLW-[A-Z0-9]{2,6}-\\d{2}$"},
        "title": {"type": "string"},
        "apis": {"type": "array", "items": {"type": "string"}},
        "requirements": {"type": "array", "items": {"type": "string"}},
        "inventory_keys": {"type": "array", "items": {"type": "string"}}
      }
    }},
    "screens": {"type": "array", "items": {
      "type": "object", "required": ["id", "inventory_key", "route", "title", "purpose", "sources", "fields", "actions"],
      "properties": {
        "id": {"type": "string", "pattern": "^SCR-[A-Z0-9]{2,6}-\\d{3}$"},
        "inventory_key": {"type": "string"},
        "route": {"type": "string"},
        "title": {"type": "string"},
        "purpose": {"type": "string", "minLength": 10},
        "menu": {"type": "string"},
        "profiles": {"type": "array", "items": {"type": "string"}},
        "sources": {"$ref": "#sources"},
        "fields": {"type": "array", "items": {
          "type": "object", "required": ["label", "type", "required"],
          "properties": {
            "label": {"type": "string"}, "name": {"type": "string"}, "type": {"type": "string"},
            "required": {"type": ["boolean", "string"]}, "mask": {"type": "string"},
            "default": {"type": ["string", "number", "boolean", "null"]},
            "options": {"type": ["array", "string"]}, "validation": {"type": "string"},
            "api_field": {"type": "string"}
          }
        }},
        "actions": {"type": "array", "items": {
          "type": "object", "required": ["label", "result"],
          "properties": {
            "label": {"type": "string"}, "api": {"type": "string"}, "external_call": {"type": "string"},
            "precondition": {"type": "string"}, "result": {"type": "string", "minLength": 3},
            "messages": {"type": "array", "items": {"type": "string"}}, "navigates_to": {"type": "string"}
          }
        }},
        "confidence": {"$ref": "#confidence"},
        "critic": {"$ref": "#critic"}
      }
    }},
    "data": {"type": "array", "items": {
      "type": "object", "required": ["inventory_key", "table", "access", "tenant_filtered", "sources"],
      "properties": {
        "inventory_key": {"type": "string"},
        "table": {"type": "string"},
        "access": {"type": "string", "enum": ["R", "W", "RW"]},
        "tenant_filtered": {"type": ["boolean", "string"]},
        "sources": {"$ref": "#sources"}
      }
    }},
    "covers": {"type": "array", "items": {
      "type": "object", "required": ["inventory_key", "by"],
      "properties": {"inventory_key": {"type": "string"}, "by": {"type": "array", "minItems": 1, "items": {"type": "string"}}}
    }},
    "exclusions": {"type": "array", "items": {
      "type": "object", "required": ["inventory_key", "status", "reason", "evidence"],
      "properties": {
        "inventory_key": {"type": "string"},
        "status": {"type": "string", "enum": ["dead", "dormant", "out_of_scope"]},
        "reason": {"type": "string", "minLength": 10},
        "evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    }}
  }
}
