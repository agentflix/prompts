{
  "title": "manifest.json",
  "type": "object",
  "required": ["contract_version", "system", "language", "repos", "modules", "phases"],
  "properties": {
    "contract_version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "system": {"type": "string", "minLength": 1},
    "language": {"type": "string", "minLength": 2},
    "output_root": {"type": "string"},
    "has_frontend": {"type": "boolean"},
    "environments": {"type": "object"},
    "approvals": {
      "type": "object",
      "properties": {
        "adapter": {
          "type": "object", "required": ["by", "date"],
          "properties": {"by": {"type": "string", "minLength": 2}, "date": {"type": "string", "minLength": 8},
                         "note": {"type": "string"}}
        }
      }
    },
    "created_at": {"type": "string"},
    "updated_at": {"type": "string"},
    "repos": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "path", "commit"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "commit": {"type": "string", "pattern": "^[0-9a-f]{7,40}$"},
          "role": {"type": "string"}
        }
      }
    },
    "modules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "name", "status"],
        "properties": {
          "code": {"type": "string", "pattern": "^[A-Z0-9]{2,6}$"},
          "name": {"type": "string", "minLength": 1},
          "status": {"type": "string", "enum": ["pending", "in_progress", "extracted", "verified", "blocked"]},
          "depends_on": {"type": "array", "items": {"type": "string"}},
          "note": {"type": "string"}
        }
      }
    },
    "phases": {
      "type": "object",
      "properties": {
        "0": {"$ref": "#phase"}, "1": {"$ref": "#phase"}, "2": {"$ref": "#phase"},
        "3": {"$ref": "#phase"}, "4": {"$ref": "#phase"}, "5": {"$ref": "#phase"},
        "6": {"$ref": "#phase"}, "7": {"$ref": "#phase"}, "8": {"$ref": "#phase"}
      }
    }
  },
  "$defs_local": {
    "phase": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {"type": "string", "enum": ["pending", "in_progress", "done", "verified", "skipped"]},
        "note": {"type": "string"}
      }
    }
  }
}
