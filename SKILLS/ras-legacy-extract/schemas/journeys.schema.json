{
  "title": "03-journeys/journeys.json",
  "type": "object",
  "required": ["contract_version", "journeys"],
  "properties": {
    "contract_version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "journeys": {"type": "array", "items": {
      "type": "object", "required": ["id", "title", "actor", "steps"],
      "properties": {
        "id": {"type": "string", "pattern": "^JRN-\\d{2}$"},
        "title": {"type": "string"},
        "actor": {"type": "string"},
        "modules": {"type": "array", "items": {"type": "string"}},
        "steps": {"type": "array", "minItems": 1, "items": {
          "type": "object", "required": ["n", "action"],
          "properties": {
            "n": {"type": "integer", "minimum": 1},
            "screen": {"type": "string"},
            "action": {"type": "string"},
            "api": {"type": "string"},
            "requirements": {"type": "array", "items": {"type": "string"}}
          }
        }}
      }
    }}
  }
}
