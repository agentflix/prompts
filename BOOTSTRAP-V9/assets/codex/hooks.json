{
  "description": "PREVEC V9: os mesmos hooks do Claude Code, lidos de .claude/hooks.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "apply_patch",
        "hooks": [
          { "type": "command", "command": "bash \"$(git rev-parse --show-toplevel)/.claude/hooks/guard.sh\"", "timeout": 10, "statusMessage": "Conferindo arquivos protegidos" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "apply_patch",
        "hooks": [
          { "type": "command", "command": "bash \"$(git rev-parse --show-toplevel)/.claude/hooks/format.sh\"", "timeout": 30 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "bash \"$(git rev-parse --show-toplevel)/.claude/hooks/gate.sh\"", "timeout": 600, "statusMessage": "Rodando gate rápido" }
        ]
      }
    ]
  }
}
